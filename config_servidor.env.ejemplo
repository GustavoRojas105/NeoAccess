# NeoAccess - Configuración local del servidor
# 1. Copie este archivo como "config_servidor.env" (en la misma carpeta).
# 2. Rellene los valores. config_servidor.env NO se sube a Git (.gitignore).
# 3. Pruebe el envío:  python backend\mailer.py su.correo@itsoeh.edu.mx

# --- Correo que envía las verificaciones de cuenta ---
# Google Workspace: smtp.gmail.com   |   Microsoft 365: smtp.office365.com
NEOACCESS_SMTP_HOST=smtp.gmail.com
NEOACCESS_SMTP_PORT=587
NEOACCESS_SMTP_USER=neoaccess@itsoeh.edu.mx
# Contraseña de APLICACIÓN (no la contraseña normal de la cuenta)
NEOACCESS_SMTP_PASSWORD=
# Remitente visible (opcional)
NEOACCESS_SMTP_FROM=NeoAccess ITSOEH <neoaccess@itsoeh.edu.mx>

# --- Dirección del servidor que aparecerá en el enlace del correo ---
# Use la IP fija de esta PC en la red del ITSOEH (o su dominio con HTTPS).
NEOACCESS_PUBLIC_URL=http://192.168.1.50:8000
